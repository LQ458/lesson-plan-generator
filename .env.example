# Local ports and same-origin web proxy
PORT=3001
API_BASE_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://localhost:3000

# The credential-free default. Set to external only when the URL is configured.
RAG_MODE=fixture
RAG_SERVICE_URL=
RAG_SERVICE_TOKEN=
RAG_TIMEOUT_MS=8000
MAX_CONTEXT_CHARS=3200

# The credential-free default produces deterministic demonstration output.
GENERATION_MODE=fixture
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=30000
